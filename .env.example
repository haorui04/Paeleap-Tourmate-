# DeepSeek Sub2API Responses API base URL (server appends /responses)
AI_BASE_URL=https://api.miaoquai.com/v1
AI_API_KEY=replace_me
# Alternative to AI_API_KEY (Codex CLI naming); takes precedence if both are set.
SUB2API_API_KEY=replace_me
AI_MODEL=deepseek-v4-pro

# Supabase project dedicated to this chatbot
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
# LEGACY service_role JWT, SERVER ONLY. Never prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Browser-safe authentication values; use the SAME project as the server above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_me

# OPTIONAL LOCAL TESTING ONLY: refuses to work in production.
ALLOW_LOCAL_DEMO=false
AI_MOCK_MODE=false

# Local SQLite is created/updated from data/china-tourism-faq.js.
# Requires Node >=22.13 and writable persistent storage for .paeleap/.
# For Supabase: apply supabase/faq-schema.sql and generated faq-seed.sql first.
FAQ_BANK_SOURCE=supabase
# AI_MOCK_MODE=true uses offline matching, not a live AI model.
# Set false plus real AI_* credentials for semantic AI question selection.

# Enable bounded multi-record AI evidence selection only after
# validating Miaoqu credentials and the Responses API in staging.
# "faq" preserves exact-answer matching. "grounded" composes approved records;
# "generated" enables reference-grounded, AI-written TourMate answers; see
# docs/GENERATED-ANSWERS.md for validation limits and live verification.
# Custom museum personas retain approved-record evidence selection.
AI_RESPONSE_MODE=faq

# The API *protocol* is model-dependent. Set exactly one:
# responses: for Codex wire_api="responses" providers
# chat_completions: for Kimi's OpenAI-compatible Chat Completions
# anthropic: for OpenCode @ai-sdk/anthropic or Claude Messages providers
# Default remains responses for existing deployments.
AI_API_STYLE=responses
# AI_MODEL must be an exact model ID allowed by the API key's provider group.
# For Kimi ask the provider for its actual ID; do not reuse Claude IDs.

# Comma-separated Supabase Auth user UUIDs permitted to publish museum profiles.
# Server-only. Empty disables administration. Never use user_metadata as a role.
PERSONA_ADMIN_USER_IDS=
# Optional incident control: disable named profiles (including tourmate).
# Comma-separated slugs; malformed settings fail closed. Admin repair stays open.
PERSONA_DISABLED_IDS=
# Local demonstration only; ignored in production. Not real museum content.
PERSONA_LOAD_EXAMPLES=false
